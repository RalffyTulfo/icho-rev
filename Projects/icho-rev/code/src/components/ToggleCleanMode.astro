<!-- src/components/ToggleCleanMode.astro -->
<button
  id="clean-mode-toggle"
  class="frosted-glass p-3 rounded-full flex items-center justify-center transition-transform active:scale-95"
  aria-label="Toggle clean mode"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-filter"
  >
    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
  </svg>
</button>

<script>
  function initCleanModeToggle() {
    // Ensure clean mode is OFF by default
    const cleanMode = localStorage.getItem('cleanMode');
    if (cleanMode === null) {
      localStorage.setItem('cleanMode', 'false');
      document.body.classList.remove('clean-mode');
    }

    const button = document.getElementById('clean-mode-toggle');
    if (!button) return;

    button.addEventListener('click', () => {
      try {
        const isClean = document.body.classList.toggle('clean-mode');
        localStorage.setItem('cleanMode', String(isClean));
      } catch (e) {}
    });
  }

  if (document.readyState !== 'loading') {
    initCleanModeToggle();
  } else {
    document.addEventListener('DOMContentLoaded', initCleanModeToggle);
  }
</script>

<style>
  .lucide {
    display: inline-block;
    transition: transform 0.2s ease;
  }
</style>
