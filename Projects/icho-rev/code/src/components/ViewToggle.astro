---
// View Toggle component for lesson pages
// Initial SSR states (default to scroll view)
const view = 'scroll';
const col = '2';
---

<div class="flex items-center gap-3 mb-6">
  <!-- View toggle buttons -->
  <button
    id="btn-scroll"
    class="rounded-md border border-2 px-4 py-2 text-sm font-medium transition-colors hover:bg-primary hover:text-primary-foreground"
  >
    Scroll
  </button>

  <button
    id="btn-study"
    class="rounded-md border border-2 px-4 py-2 text-sm font-medium transition-colors hover:bg-primary hover:text-primary-foreground"
  >
    Study
  </button>

  <button
    id="btn-cards"
    class="rounded-md border border-2 px-4 py-2 text-sm font-medium transition-colors hover:bg-primary hover:text-primary-foreground"
  >
    All cards
  </button>

  <!-- Per-column selector: All cards only -->
  <div id="col-control" class="hidden">
    <select
      id="col-selector"
      class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
    >
      <option value="1">1 column</option>
      <option value="2" selected>2 columns</option>
      <option value="3">3 columns</option>
    </select>
  </div>
</div>

<script>
  const STORAGE_KEY = 'icho-rev-view-mode'
  const COL_KEY = 'icho-rev-cols'

  function setStored(key, value) {
    try {
      localStorage.setItem(key, value)
    } catch (e) {}
  }

  function getStored(key, defaultValue) {
    try {
      const val = localStorage.getItem(key)
      return val !== null ? val : defaultValue
    } catch (e) {
      return defaultValue
    }
  }

  // Delay element lookup until DOM is fully ready
  function initToggle() {
    const btnScroll = document.getElementById('btn-scroll')
    const btnStudy = document.getElementById('btn-study')
    const btnCards = document.getElementById('btn-cards')
    const colSelector = document.getElementById('col-selector')
    const colControl = document.getElementById('col-control')
    const wrapper = document.querySelector('.view-wrapper')

    const setPressed = (button: HTMLElement | null, pressed: boolean) => {
      if (!button) return
      button.setAttribute('aria-pressed', String(pressed))
      button.classList.toggle('bg-primary', pressed)
      button.classList.toggle('text-white', pressed)
    }

    function updateUI() {
      const view = getStored(STORAGE_KEY, 'scroll')
      const cols = getStored(COL_KEY, '2')

      // Update buttons
      setPressed(btnScroll, view === 'scroll')
      setPressed(btnStudy, view === 'study')
      setPressed(btnCards, view === 'cards')

      // Columns only apply to All cards
      if (colControl) colControl.classList.toggle('hidden', view !== 'cards')

      // Update select
      if (colSelector) {
        (colSelector as HTMLSelectElement).value = cols
      }

      // Update content wrapper - set data-view and data-cols attributes
      // so CSS can react with [data-view] and [data-cols] selectors
      if (wrapper) {
        wrapper.classList.remove('grid-cols-1', 'grid-cols-2', 'grid-cols-3')
        wrapper.setAttribute('data-view', view)
        wrapper.setAttribute('data-cols', cols)
        if (view === 'cards') {
          wrapper.classList.add(`grid-cols-${cols}`)
        }
      }

      // Single source of truth for the three views
      document.dispatchEvent(new CustomEvent('viewModeChange', { detail: { view } }))
    }

    // Attach click handlers - update aria-pressed and data attributes
    if (btnScroll) {
      btnScroll.addEventListener('click', () => {
        setStored(STORAGE_KEY, 'scroll')
        updateUI()
      })
    }

    if (btnStudy) {
      btnStudy.addEventListener('click', () => {
        setStored(STORAGE_KEY, 'study')
        updateUI()
      })
    }

    if (btnCards) {
      btnCards.addEventListener('click', () => {
        setStored(STORAGE_KEY, 'cards')
        updateUI()
      })
    }

    if (colSelector) {
      colSelector.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value
        setStored(COL_KEY, val)
        updateUI()
      })
    }

    // Initial update on page load
    updateUI()

    // Also update when ToC highlights changes (if needed)
    document.addEventListener('astro:after-swap', updateUI)
  }

  // Initialize when DOM is ready
  if (document.readyState !== 'loading') {
    initToggle()
  } else {
    document.addEventListener('DOMContentLoaded', initToggle)
  }
</script>