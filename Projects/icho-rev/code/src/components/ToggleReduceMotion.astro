<!-- src/components/ToggleReduceMotion.astro -->
<button
  id="reduce-motion-toggle"
  class="frosted-glass p-3 rounded-full flex items-center justify-center transition-transform active:scale-95"
  aria-label="Toggle reduce motion"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-wave-sine"
  >
    <path d="M12 21v-9l-3 3-3-3v9h6z" />
    <path d="M12 21v-9l3-3 3 3v9h-6z" />
    <path d="M12 21v-9l-3-3 3-3v9h6z" />
    <path d="M12 21v-9l3 3-3 3v9h-6z" />
  </svg>
</button>

<script>
  function initReduceMotionToggle() {
    const button = document.getElementById('reduce-motion-toggle');
    if (!button) return;

    button.addEventListener('click', () => {
      try {
        const reduceMotion = document.body.classList.toggle('reduce-motion');
        localStorage.setItem('reduceMotion', String(reduceMotion));
      } catch (e) {}
    });
  }

  if (document.readyState !== 'loading') {
    initReduceMotionToggle();
  } else {
    document.addEventListener('DOMContentLoaded', initReduceMotionToggle);
  }
</script>

<style>
  .lucide {
    display: inline-block;
    transition: transform 0.2s ease;
  }
</style>
