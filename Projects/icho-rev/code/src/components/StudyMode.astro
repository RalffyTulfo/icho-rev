---
// StudyMode.astro
---
<div id="study-mode-wrapper" class="hidden flex-col gap-8 w-full">
  <div class="frosted-glass p-4 rounded-2xl border border-var(--color-border) flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3 flex-wrap">
      <div class="flex items-center gap-2">
        <label for="study-category-select" class="text-xs font-semibold text-foreground/70">Category:</label>
        <select id="study-category-select" class="bg-[var(--color-surface-2)] text-foreground border border-var(--color-border) rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="all">All Categories</option>
        </select>
      </div>
      <label class="flex items-center gap-2 text-xs font-semibold text-foreground/80 cursor-pointer select-none">
        <input type="checkbox" id="study-hide-mastered" class="rounded border-var(--color-border) bg-[var(--color-surface-2)] text-primary focus:ring-primary" />
        Hide Mastered
      </label>
    </div>
    <button id="study-shuffle-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-var(--color-border) var(--color-surface-2) hover:var(--color-surface-2) text-xs font-semibold text-foreground transition-all active:scale-95">
      Shuffle
    </button>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8 flex flex-col gap-6 w-full">
      <div id="active-study-card" class="frosted-glass p-6 md:p-8 rounded-3xl border border-var(--color-border) shadow-2xl relative min-h-[420px] flex flex-col justify-between transition-all duration-300">
        <div class="flex items-center justify-between gap-2 mb-6">
          <span id="study-card-category" class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-primary/20 text-primary border border-primary/30">Category</span>
          <span id="study-card-status-pill" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[var(--color-surface-3)] text-foreground/60 border border-var(--color-border)">Not Started</span>
        </div>
        <div id="study-card-content" class="lesson-content-cards flex-1 space-y-4 text-foreground/90 text-sm leading-relaxed"></div>
        <div class="mt-8 pt-4 border-t border-var(--color-border) flex items-center justify-between text-xs text-foreground/50">
          <span id="study-card-progress-text">Card 1 of 24</span>
          <div class="w-24 h-1.5 var(--color-surface-2) rounded-full overflow-hidden">
            <div id="study-card-progress-bar" class="h-full bg-primary transition-all duration-300 w-0"></div>
          </div>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-2">
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <button id="study-mark-mastered-btn" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 rounded-2xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold text-xs hover:bg-emerald-500/30 transition-all active:scale-95 shadow-lg shadow-emerald-950/20">I Know This</button>
          <button id="study-reset-card-btn" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl var(--color-surface-2) hover:var(--color-surface-2) text-foreground/70 border border-var(--color-border) text-xs font-semibold transition-all active:scale-95">Reset</button>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
          <button id="study-prev-btn" class="px-4 py-2.5 rounded-2xl var(--color-surface-2) hover:var(--color-surface-2) border border-var(--color-border) text-xs font-bold text-foreground transition-all active:scale-95 disabled:opacity-40">&lt; Previous</button>
          <button id="study-next-btn" class="px-4 py-2.5 rounded-2xl bg-primary hover:bg-primary/90 text-primary-foreground text-xs font-bold transition-all active:scale-95 disabled:opacity-40 shadow-lg shadow-primary/20">Next &gt;</button>
        </div>
      </div>
    </div>
    <div class="lg:col-span-4 w-full">
      <div class="frosted-glass p-6 rounded-3xl border border-var(--color-border) space-y-4 shadow-xl">
        <h3 class="text-sm font-bold uppercase tracking-wider text-foreground/80 mb-2">Study Statistics</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3">
          <div class="p-4 rounded-2xl bg-[var(--color-surface-3)] border border-var(--color-border) flex items-center justify-between">
            <div><p class="text-[11px] font-semibold text-foreground/60 uppercase tracking-wide">Total Cards</p><p id="stat-total" class="text-2xl font-black text-foreground mt-0.5">0</p></div>
          </div>
          <div class="p-4 rounded-2xl bg-[var(--color-surface-3)] border border-emerald-500/20 flex items-center justify-between">
            <div><p class="text-[11px] font-semibold text-emerald-400/80 uppercase tracking-wide">Mastered</p><p id="stat-mastered" class="text-2xl font-black text-emerald-400 mt-0.5">0</p></div>
          </div>
          <div class="p-4 rounded-2xl bg-[var(--color-surface-3)] border border-amber-500/20 flex items-center justify-between">
            <div><p class="text-[11px] font-semibold text-amber-400/80 uppercase tracking-wide">In Progress</p><p id="stat-in-progress" class="text-2xl font-black text-amber-400 mt-0.5">0</p></div>
          </div>
          <div class="p-4 rounded-2xl bg-[var(--color-surface-3)] border border-purple-500/20 flex items-center justify-between">
            <div><p class="text-[11px] font-semibold text-purple-400/80 uppercase tracking-wide">Not Started</p><p id="stat-not-started" class="text-2xl font-black text-purple-400 mt-0.5">0</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

