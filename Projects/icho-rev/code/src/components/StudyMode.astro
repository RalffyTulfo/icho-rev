---
// StudyMode.astro — layout per STUDY_LAYOUT_SPEC.md; behaviour lives in study-mode.ts
import '../styles/study.css';
---
<div id="study-mode-wrapper" class="study-shell hidden flex-col w-full">
  <div class="study-layout">
    <section class="study-panel" aria-label="Study panel">
      <!-- toolbar -->
      <div class="study-toolbar">
        <div class="study-toolbar-left">
          <div class="study-field">
            <label for="study-category-select" class="sr-only">Category</label>
            <select id="study-category-select" class="study-select">
              <option value="all">All categories</option>
            </select>
          </div>
          <label class="study-check">
            <input type="checkbox" id="study-hide-mastered" />
            Hide Mastered
          </label>
        </div>
        <div class="study-toolbar-right">
          <div id="study-cols-control" class="study-cols hidden" role="group" aria-label="Columns">
            <span class="study-cols-label" aria-hidden="true">Columns</span>
            <button type="button" data-cols="1" aria-pressed="false" aria-label="Columns 1">1</button>
            <button type="button" data-cols="2" aria-pressed="true" aria-label="Columns 2">2</button>
            <button type="button" data-cols="3" aria-pressed="false" aria-label="Columns 3">3</button>
          </div>
          <button id="study-shuffle-btn" class="study-pill study-pill-no-chevron" aria-pressed="false" aria-label="Shuffle cards">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="m4 4 5 5"/></svg>
            <span id="study-shuffle-label">Shuffle</span>
          </button>
        </div>
      </div>

      <!-- single card (Study view) -->
      <div id="study-stage" class="study-stage">
        <div id="study-overview" class="study-overview hidden"></div>
        <div id="study-empty" class="study-empty hidden" role="status">
          <h3>All caught up</h3>
          <p>Every card in this filter is mastered.</p>
          <button type="button" id="study-show-all-btn" class="study-btn study-btn-ghost">Show all cards</button>
        </div>
        <div id="active-study-card" class="study-card">
          <div class="study-card-head">
            <span id="study-card-category" class="study-badge">Category</span>
            <div id="study-card-title" class="study-title"></div>
            <svg class="study-sparkle study-sparkle-tr" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg>
            <svg class="study-sparkle study-sparkle-bl" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/></svg>
          </div>
          <div id="study-card-content" class="study-card-body"></div>
          <div class="study-card-foot">
            <span class="study-track" aria-hidden="true"><span id="study-card-progress-bar" style="width: 0%"></span></span>
            <span id="study-card-status-pill" class="font-semibold">Not Started</span>
          </div>
        </div>
        <div class="study-actions">
          <button type="button" id="study-mark-mastered-btn" class="study-btn study-btn-master" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg>
            <span id="study-mark-mastered-label">I Know This</span>
          </button>
          <button type="button" id="study-reset-card-btn" class="study-btn study-btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            <span>Reset Progress</span>
          </button>
        </div>
        <div class="study-nav">
          <button type="button" id="study-prev-btn" class="study-nav-btn">‹ Previous</button>
          <span id="study-card-progress-text" class="study-nav-count" aria-live="polite">Card 1 of 24</span>
          <button type="button" id="study-next-btn" class="study-nav-btn">Next ›</button>
        </div>
        <details id="study-recall" class="study-recall hidden">
          <summary>Recall Cards</summary>
          <div id="study-recall-body" class="study-card-body"></div>
        </details>
        <div id="study-end" class="study-end hidden"></div>
      </div>

      <!-- all cards grid -->
      <div id="study-grid-wrap" class="study-grid-area hidden">
        <div id="all-cards-grid" class="study-card-grid" data-columns="2"></div>
        <div id="study-grid-empty" class="study-empty hidden" role="status">
          <h3>All caught up</h3>
          <p>No cards match this filter.</p>
          <button type="button" id="study-grid-show-all-btn" class="study-btn study-btn-ghost">Show all cards</button>
        </div>
      </div>
    </section>

    <details id="study-stats" class="study-stats" open>
      <summary>Study Statistics</summary>
      <div class="study-stat-list" aria-live="polite">
        <div class="study-stat" data-stat="total">
          <div><span class="study-stat-label">Total Cards</span><span id="stat-total" class="study-stat-value">0</span></div>
          <span class="study-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 12 10 5 10-5"/><path d="m2 17 10 5 10-5"/></svg></span>
        </div>
        <div class="study-stat" data-stat="mastered">
          <div><span class="study-stat-label">Mastered</span><span id="stat-mastered" class="study-stat-value">0</span></div>
          <span class="study-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg></span>
        </div>
        <div class="study-stat" data-stat="progress">
          <div><span class="study-stat-label">In Progress</span><span id="stat-in-progress" class="study-stat-value">0</span></div>
          <span class="study-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg></span>
        </div>
        <div class="study-stat" data-stat="idle">
          <div><span class="study-stat-label">Not Started</span><span id="stat-not-started" class="study-stat-value">0</span></div>
          <span class="study-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span>
        </div>
      </div>
    </details>
  </div>
</div>

<style is:global>
  .study-overview {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  /* Readable measure for prose only; equations and tables may use the full width. */
  .study-card-body :is(p, li, h2, h3, h4),
  .study-overview :is(p, li) {
    max-width: 70ch;
  }

  .study-recall {
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface-2);
  }

  .study-recall > summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-text);
  }

  .study-end {
    padding: 1rem 1.25rem;
    border-top: 1px dashed var(--color-border);
    color: var(--color-text);
  }
</style>

