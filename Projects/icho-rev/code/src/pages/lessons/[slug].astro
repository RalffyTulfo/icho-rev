---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lessons = await Astro.glob('../../content/lessons/*.mdx');
  return lessons.map(lesson => ({
    params: { slug: lesson.file.split('/').pop().replace('.mdx', '') },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = lesson;
---
<Layout>
  <main class="pt-20 px-4 max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 min-h-screen pb-16">
    <!-- Sticky Table of Contents / Sidebar -->
    <aside class="w-full lg:w-72 flex-shrink-0">
      <div class="sticky top-24 frosted-glass p-6 rounded-2xl border border-white/10 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary">Lesson Navigation</h3>
        <nav class="flex flex-col space-y-2 text-sm text-foreground/80" id="lesson-nav">
          <a href="#terms-definitions" class="hover:text-primary transition-colors py-1">1. Terms & Definitions</a>
          <a href="#why-does-this-exist" class="hover:text-primary transition-colors py-1">2. Why Does This Exist?</a>
          <a href="#derivation-from-first-principles" class="hover:text-primary transition-colors py-1">3. Derivation from First Principles</a>
          <a href="#worked-example" class="hover:text-primary transition-colors py-1">4. Worked Example</a>
          <a href="#common-icho-traps" class="hover:text-primary transition-colors py-1">5. Common Traps</a>
          <a href="#what-graders-want-to-see" class="hover:text-primary transition-colors py-1">6. What Graders Want to See</a>
          <a href="#recall-cards" class="hover:text-primary transition-colors py-1">7. Recall Cards</a>
        </nav>
        <div class="pt-4 border-t border-foreground/10">
          <a href="/icho-rev/roadmap" class="text-xs text-primary font-semibold hover:underline flex items-center gap-1">
            ← Back to Roadmap
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Stream rendered as discrete, card-like modular blocks -->
    <article class="flex-1 space-y-8 min-w-0">
      <header class="frosted-glass p-8 rounded-2xl border border-white/10">
        <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">{lesson.frontmatter.unit || 'Lesson'}</span>
        <h1 class="text-3xl md:text-4xl font-black text-foreground tracking-tight">{lesson.frontmatter.title}</h1>
        {lesson.frontmatter.readingTime && (
          <p class="text-xs text-foreground/60 mt-2">⏱️ Reading time: {lesson.frontmatter.readingTime}</p>
        )}
      </header>

      <!-- MDX Content Container -->
      <div class="lesson-content-cards space-y-8">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<script>
  // Add IDs to headings dynamically so navigation links work seamlessly
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.lesson-content-cards h2');
    headings.forEach(h => {
      const text = h.textContent || '';
      if (text.includes('Terms')) h.id = 'terms-definitions';
      else if (text.includes('Why')) h.id = 'why-does-this-exist';
      else if (text.includes('Derivation')) h.id = 'derivation-from-first-principles';
      else if (text.includes('Worked Example') || text.includes('Example')) h.id = 'worked-example';
      else if (text.includes('Traps')) h.id = 'common-icho-traps';
      else if (text.includes('Graders')) h.id = 'what-graders-want-to-see';
      else if (text.includes('Recall')) h.id = 'recall-cards';
    });
  });
</script>

<style is:global>
  /* Wrap MDX H2 top-level sections into discrete Card Blocks */
  .lesson-content-cards > h2 {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1);
    padding: 1.75rem 2rem 1.25rem 2rem;
    margin-top: 2rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 1.5rem;
    font-weight: 800;
    scroll-margin-top: 6rem;
  }

  :root[data-theme="dark"] .lesson-content-cards > h2 {
    background: rgba(26, 26, 46, 0.5);
    border: 1px solid rgba(147, 112, 219, 0.25);
  }

  /* Subscripts & Superscripts Styling Fixes */
  sub, sup {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
  }
  sup {
    top: -0.5em;
  }
  sub {
    bottom: -0.25em;
  }

  /* KaTeX Math Formatting Fixes */
  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.75rem;
    margin: 1rem 0;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 12px;
  }

  :root[data-theme="dark"] .katex-display {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Ensure smooth scrolling when clicking navigation anchors */
  html {
    scroll-behavior: smooth;
  }
</style>
