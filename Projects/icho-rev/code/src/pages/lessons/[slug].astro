---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lessons = await Astro.glob('../../content/lessons/*.mdx');
  return lessons.map(lesson => ({
    params: { slug: lesson.file.split('/').pop().replace('.mdx', '') },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = lesson;
const { description: frontmatterDescription, unit, readingTime } = lesson.frontmatter;
const fallbackHeading = lesson.getHeadings().find((h) => h.depth === 1)?.text;
const title =
  lesson.frontmatter.title ||
  fallbackHeading ||
  lesson.file.split('/').pop().replace('.mdx', '');
const metaDescription =
  frontmatterDescription ||
  (unit && readingTime
    ? `${title}. ${unit} lesson for IChO revision (${readingTime} read).`
    : `${title}. IChO revision lesson.`);
import ViewToggle from '../../components/ViewToggle.astro';
import MobileNav from '../../components/MobileNav.astro';
import StudyMode from '../../components/StudyMode.astro';
---
<Layout title={title} description={metaDescription}>
  <main class="pt-20 px-4 max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 min-h-screen pb-16">
    <!-- Sticky Table of Contents / Sidebar -->
    <aside class="w-full lg:w-72 flex-shrink-0">
      <div class="sticky top-24 frosted-glass p-6 rounded-2xl border border-var(--color-border) space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary">Lesson Navigation</h3>
        <nav id="toc" class="flex flex-col space-y-2 text-sm text-foreground/80">
          <ul></ul>
        </nav>
        <div class="pt-4 border-t border-var(--color-border)">
          <a href="/icho-rev/roadmap" class="text-xs text-primary font-semibold hover:underline flex items-center gap-1">
            ← Back to Roadmap
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Stream -->
    <div class="flex-1 min-w-0">
      <ViewToggle />
      <MobileNav />
      <StudyMode />
      <article class="view-wrapper space-y-8">
        <header class="frosted-glass p-8 rounded-2xl border border-var(--color-border)">
          <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">{lesson.frontmatter.unit || 'Lesson'}</span>
          <h1 class="text-3xl md:text-4xl font-black text-foreground tracking-tight">{lesson.frontmatter.title}</h1>
          {lesson.frontmatter.readingTime && (
            <p class="text-xs text-foreground/60 mt-2">⏱️ Reading time: {lesson.frontmatter.readingTime}</p>
          )}
        </header>

        <!-- MDX Content Container -->
        <div class="lesson-content-cards space-y-8">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<script>
  import "../../scripts/toc.ts";
  import "../../scripts/cards.ts";
</script>

<style is:global>
  /* Wrap MDX H2 top-level sections into discrete Card Blocks */
  .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1);
    padding: 1.75rem 2rem 1.25rem 2rem;
    margin-top: 2rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 1.5rem;
    font-weight: 800;
    scroll-margin-top: 6rem;
  }

  :root[data-theme="dark"] .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  :root[data-theme="light"] .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  /* Subscripts & Superscripts Styling Fixes */
  sub, sup {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
  }
  sup {
    top: -0.5em;
  }
  sub {
    bottom: -0.25em;
  }

  /* KaTeX Math Formatting Fixes */
  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.75rem;
    margin: 1rem 0;
    background: var(--color-surface-2);
    border-radius: 12px;
  }

  :root[data-theme="dark"] .katex-display {
    background: var(--color-surface-2);
  }

  :root[data-theme="light"] .katex-display {
    background: var(--color-surface-2);
  }

  /* Ensure smooth scrolling when clicking navigation anchors */
  html {
    scroll-behavior: smooth;
  }
</style>
