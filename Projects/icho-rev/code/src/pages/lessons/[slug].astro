---
import Layout from '../../layouts/Layout.astro';
import CalorimetrySimulator from '../../components/interactives/CalorimetrySimulator.jsx';
import HessBuilder from '../../components/interactives/HessBuilder.jsx';
import FirstLawSimulator from '../../components/interactives/FirstLawSimulator.jsx';
import EntropySimulator from '../../components/interactives/EntropySimulator.jsx';

export async function getStaticPaths() {
  const lessons = await Astro.glob('../../content/lessons/*.mdx');
  return lessons.map(lesson => ({
    params: { slug: lesson.file.split('/').pop().replace('.mdx', '') },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = lesson;
---
<Layout>
  <main class="pt-20 px-4 max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 min-h-[calc(100vh-5rem)]">
    <!-- Sticky Table of Contents / Sidebar -->
    <aside class="w-full lg:w-64 flex-shrink-0">
      <div class="sticky top-24 frosted-glass p-6 rounded-2xl border border-white/10 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-foreground/50">Lesson Navigation</h3>
        <nav class="flex flex-col space-y-2 text-sm">
          <a href="#terms" class="hover:text-primary transition-colors py-1">1. Terms & Definitions</a>
          <a href="#why" class="hover:text-primary transition-colors py-1">2. Why Does This Exist?</a>
          <a href="#derivation" class="hover:text-primary transition-colors py-1">3. Derivation / Postulates</a>
          <a href="#example" class="hover:text-primary transition-colors py-1">4. Worked Example</a>
          <a href="#traps" class="hover:text-primary transition-colors py-1">5. Common Traps</a>
          <a href="#recall" class="hover:text-primary transition-colors py-1">6. Recall Cards</a>
        </nav>
        <div class="pt-4 border-t border-foreground/10">
          <a href="/icho-rev/roadmap" class="text-xs text-primary hover:underline flex items-center gap-1">
            ← Back to Roadmap
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Container with max-width and clean layout -->
    <article class="flex-1 frosted-glass p-8 rounded-2xl border border-white/10 overflow-x-hidden">
      <h1 class="text-3xl font-extrabold mb-6 text-foreground tracking-tight">{lesson.frontmatter.title}</h1>
      <div class="prose dark:prose-invert max-w-none text-foreground/90 space-y-6">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Ensure KaTeX display equations wrap/scroll properly and don't break width on 1080p */
  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }
  /* Style section anchors dynamically if present */
  html {
    scroll-behavior: smooth;
  }
</style>
