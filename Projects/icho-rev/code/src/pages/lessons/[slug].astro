---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const lessons = await Astro.glob('../../content/lessons/*.mdx');
  return lessons.map(lesson => ({
    params: { slug: lesson.file.split('/').pop().replace('.mdx', '') },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = lesson;
const { description: frontmatterDescription, unit, readingTime } = lesson.frontmatter;
const fallbackHeading = lesson.getHeadings().find((h) => h.depth === 1)?.text;
const title =
  lesson.frontmatter.title ||
  fallbackHeading ||
  lesson.file.split('/').pop().replace('.mdx', '');
const metaDescription =
  frontmatterDescription ||
  (unit && readingTime
    ? `${title}. ${unit} lesson for IChO revision (${readingTime} read).`
    : `${title}. IChO revision lesson.`);
import ViewToggle from '../../components/ViewToggle.astro';
import MobileNav from '../../components/MobileNav.astro';
import StudyMode from '../../components/StudyMode.astro';
---
<Layout title={title} description={metaDescription}>
  <main class="pt-20 px-4 max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 min-h-screen pb-16">
    <!-- Sticky Table of Contents / Sidebar -->
    <aside class="lesson-aside hidden w-full lg:block lg:w-72 flex-shrink-0">
      <div class="toc-panel sticky top-24 frosted-glass p-6 rounded-2xl border border-var(--color-border) flex flex-col gap-3 max-h-[calc(100vh-8rem)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary">Lesson Navigation</h3>
        <nav id="toc" class="toc-nav" aria-label="Lesson sections">
          <ul class="toc-list"></ul>
        </nav>
        <div class="pt-3 mt-auto border-t border-var(--color-border)">
          <a href="/icho-rev/roadmap" class="text-xs text-primary font-semibold hover:underline flex items-center gap-1">
            ← Back to Roadmap
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Stream -->
    <div class="flex-1 min-w-0">
      <ViewToggle />
      <MobileNav />
      <StudyMode />
      <article class="view-wrapper space-y-8">
        <header class="frosted-glass p-8 rounded-2xl border border-var(--color-border)">
          <span class="text-xs font-bold uppercase tracking-widest text-primary mb-2 block">{lesson.frontmatter.unit || 'Lesson'}</span>
          <h1 class="text-3xl md:text-4xl font-black text-foreground tracking-tight">{lesson.frontmatter.title}</h1>
          {lesson.frontmatter.readingTime && (
            <p class="text-xs text-foreground/60 mt-2">⏱️ Reading time: {lesson.frontmatter.readingTime}</p>
          )}
          <p class="mt-3 flex flex-wrap gap-2">
            <span class="text-[0.65rem] font-semibold rounded-full border border-var(--color-border) px-2 py-0.5 text-foreground/60">
              {lesson.frontmatter.teacherReviewed === true ? 'Teacher-reviewed' : 'Not yet teacher-reviewed'}
            </span>
            {lesson.frontmatter.legacy === true && (
              <span class="text-[0.65rem] font-semibold rounded-full border border-var(--color-border) px-2 py-0.5 text-foreground/60">
                Older draft, being rewritten
              </span>
            )}
          </p>
        </header>

        {lesson.frontmatter.legacy === true && (
          <p class="frosted-glass p-4 rounded-xl border border-var(--color-border) text-xs text-foreground/70">
            This lesson is an older draft that is being rewritten to the current standard. It stays
            live until its replacement ships, then this URL redirects to the replacement.
          </p>
        )}

        <!-- MDX Content Container -->
        <div class="lesson-content-cards space-y-8">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<script>
  import "../../scripts/toc.ts";
  import "../../scripts/cards.ts";
  import "../../scripts/study-mode.ts";
</script>

<style is:global>
  /* Wrap MDX H2 top-level sections into discrete Card Blocks */
  .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1);
    padding: 1.75rem 2rem 1.25rem 2rem;
    margin-top: 2rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 1.5rem;
    font-weight: 800;
    scroll-margin-top: 6rem;
  }

  :root[data-theme="dark"] .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  :root[data-theme="light"] .lesson-content-cards > h2 {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  /* Subscripts & Superscripts Styling Fixes */
  sub, sup {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline;
  }
  sup {
    top: -0.5em;
  }
  sub {
    bottom: -0.25em;
  }

  /* KaTeX Math Formatting Fixes */
  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.75rem;
    margin: 1rem 0;
    background: var(--color-surface-2);
    border-radius: 12px;
  }

  :root[data-theme="dark"] .katex-display {
    background: var(--color-surface-2);
  }

  :root[data-theme="light"] .katex-display {
    background: var(--color-surface-2);
  }

  /* Ensure smooth scrolling when clicking navigation anchors */
  html {
    scroll-behavior: smooth;
  }

  /* Leave room for the fixed toolbar when jumping to a heading or card */
  .view-wrapper .lesson-content-cards h2,
  .view-wrapper .lesson-content-cards h3,
  .view-wrapper .card {
    scroll-margin-top: 6.5rem;
  }

  /* Table of contents */
  aside.lesson-aside > .toc-panel {
    position: sticky;
    top: 6rem;
    align-self: flex-start;
  }

  .toc-nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.8125rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0.6rem;
    border-radius: 0.65rem;
    border-left: 2px solid transparent;
    color: var(--color-muted);
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--duration-micro) var(--ease-out),
      background-color var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out);
  }

  .toc-link:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    color: var(--color-text);
  }

  .toc-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    border-left-color: var(--color-primary);
  }

  .toc-link-2 {
    font-weight: 600;
  }

  .toc-link-3 {
    font-size: 0.78rem;
    padding-left: 1.15rem;
  }

  .toc-sublist {
    list-style: none;
    margin: 0.1rem 0 0.35rem;
    padding: 0;
    display: none;
  }

  .toc-group.is-active > .toc-sublist,
  .toc-group.is-open > .toc-sublist {
    display: block;
  }
</style>
