---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="pt-20">
    <div class="frosted-glass p-8 mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold mb-6">Thermodynamics</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="frosted-glass p-4">
          <h2 class="text-xl font-bold mb-2">First Law of Thermodynamics</h2>
          <p>ΔU = q + w</p>
        </div>
        <div class="frosted-glass p-4">
          <h2 class="text-xl font-bold mb-2">Second Law of Thermodynamics</h2>
          <p>Entropy of the universe always increases.</p>
        </div>
        <div class="frosted-glass p-4">
          <h2 class="text-xl font-bold mb-2">Gibbs Free Energy</h2>
          <p>ΔG = ΔH - TΔS</p>
        </div>
        <div class="frosted-glass p-4">
          <h2 class="text-xl font-bold mb-2">Enthalpy</h2>
          <p>H = U + PV</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
