    <div class="frosted-glass p-8 mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold mb-6">Practice Hub</h1>
      <p class="mb-6">Ready to challenge yourself? Select a topic below to start practicing.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="#" class="frosted-glass p-4 text-center">Thermodynamics</a>
        <a href="#" class="frosted-glass p-4 text-center">Quantum Chemistry</a>
        <a href="#" class="frosted-glass p-4 text-center">Spectroscopy</a>
        <a href="#" class="frosted-glass p-4 text-center">Practical</a>
      </div>
    </div>
  </main>
</Layout>
