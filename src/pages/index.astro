---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="pt-20">
    <div class="frosted-glass hero-ribbon p-8 mx-auto max-w-4xl text-center">
      <h1 class="text-4xl font-bold mb-4">Interactive Chemistry Review</h1>
      <p class="text-xl">Master the IChO with interactive lessons, practice problems, and a vibrant community.</p>
      <div class="mt-8 flex gap-4 justify-center">
        <a href="/icho-rev/roadmap" class="bg-primary text-white px-6 py-2 rounded-full">Explore Roadmap</a>
        <a href="/icho-rev/about" class="bg-secondary text-white px-6 py-2 rounded-full">About IChO</a>
      </div>
    </div>
  </main>
</Layout>
