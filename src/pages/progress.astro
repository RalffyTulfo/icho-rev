---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="pt-20">
    <div class="frosted-glass p-8 mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold mb-6">Your Progress</h1>
      <div class="flex items-center gap-4">
        <div class="w-24 h-24 rounded-full border-8 border-primary"></div>
        <div>
          <h2 class="text-xl font-bold">Thermodynamics</h2>
          <p>Progress: 75%</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
