---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="pt-20">
    <div class="frosted-glass p-8 mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold mb-6">IChO Roadmap</h1>
      <div class="relative h-64">
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="relative w-full h-16 bg-gradient-to-r from-primary to-secondary rounded-full overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-1/3 h-12 bg-white/20 rounded-full mx-1"></div>
              <div class="w-1/3 h-12 bg-white/40 rounded-full mx-1"></div>
              <div class="w-1/3 h-12 bg-white/60 rounded-full mx-1"></div>
            </div>
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 flex justify-around pb-4">
          <div class="text-center">
            <div class="w-12 h-12 bg-primary rounded-full mb-2 mx-auto"></div>
            <span class="text-sm">Thermodynamics</span>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-secondary rounded-full mb-2 mx-auto"></div>
            <span class="text-sm">Quantum Chemistry</span>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-success rounded-full mb-2 mx-auto"></div>
            <span class="text-sm">Spectroscopy</span>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-warning rounded-full mb-2 mx-auto"></div>
            <span class="text-sm">Practical</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
