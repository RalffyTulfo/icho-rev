---
import Layout from '../layouts/Layout.astro';

const units = [
  { name: 'Thermodynamics', slug: 'thermodynamics', color: 'bg-primary' },
  { name: 'Organic Chemistry', slug: 'organic', color: 'bg-organic' },
  { name: 'Inorganic Chemistry', slug: 'inorganic', color: 'bg-inorganic' },
  { name: 'Analytical Chemistry', slug: 'analytical', color: 'bg-analytical' },
  { name: 'Biochemistry', slug: 'biochemistry', color: 'bg-biochemistry' },
  { name: 'Practical', slug: 'practical', color: 'bg-practical' },
];
---
<Layout>
  <main class="pt-24 px-4 min-h-screen">
    <div class="frosted-glass p-8 mx-auto max-w-5xl">
      <h1 class="text-3xl font-bold mb-8 text-foreground">IChO Learning Roadmap</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {units.map((unit) => (
          <a href={`/icho-rev/units/${unit.slug}`} class="group">
            <div class="frosted-glass p-6 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer h-full border-t-4" style={`border-top-color: var(--color-${unit.slug})`}>
              <div class={`w-12 h-12 ${unit.color} rounded-full mb-4 flex items-center justify-center text-white font-bold`}>
                {unit.name.charAt(0)}
              </div>
              <h2 class="text-xl font-bold text-foreground mb-2 group-hover:text-primary transition-colors">{unit.name}</h2>
              <p class="text-sm text-foreground/70">Master the fundamental principles and advanced applications of {unit.name.toLowerCase()} for IChO.</p>
              <div class="mt-4 flex items-center text-xs font-semibold text-primary uppercase tracking-wider">
                Start Learning
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Local color overrides since Tailwind vars are dynamic */
  :root {
    --color-thermodynamics: var(--color-physical);
    --color-organic: var(--color-organic);
    --color-inorganic: var(--color-inorganic);
    --color-analytical: var(--color-analytical);
    --color-biochemistry: var(--color-biochemistry);
    --color-practical: var(--color-practical);
  }
</style>
