---
import Layout from '../../layouts/Layout.astro';
import CalorimetrySimulator from '../../components/interactives/CalorimetrySimulator.jsx';
import HessBuilder from '../../components/interactives/HessBuilder.jsx';

export function getStaticPaths() {
  return [
    { params: { slug: 'thermodynamics-intro' } },
    { params: { slug: 'calorimetry' } },
    { params: { slug: 'hess-law' } },
    { params: { slug: 'entropy-and-free-energy' } },
  ];
}

const { slug } = Astro.params;
---
<Layout>
  <main class="pt-20 px-4 max-w-6xl mx-auto flex gap-8">
    <!-- Sticky TOC Margin -->
    <aside class="w-64 hidden md:block sticky top-24 h-fit frosted-glass p-4 no-print">
      <h3 class="font-bold text-sm uppercase text-primary mb-3">On this page</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="#overview" class="hover:underline">Overview</a></li>
        <li><a href="#equation" class="hover:underline">Key Equation</a></li>
        <li><a href="#interactive" class="hover:underline">Interactive Concept</a></li>
      </ul>
    </aside>

    <!-- Lesson Content -->
    <article class="flex-1 frosted-glass p-8">
      <h1 class="text-3xl font-bold mb-4 capitalize">{slug.replace('-', ' ')}</h1>

      <!-- Progress Bar -->
      <div class="w-full bg-foreground/10 h-1.5 rounded-full mb-6 no-print">
        <div class="bg-primary h-1.5 rounded-full w-2/3"></div>
      </div>

      <section id="overview" class="mb-8">
        <p class="text-lg mb-4">Deep dive into {slug.replace('-', ' ')} for International Chemistry Olympiad (IChO) preparation.</p>
        <div class="bg-primary/10 border-l-4 border-primary p-4 rounded my-4">
          <p class="font-semibold text-primary">💥 IChO Core Principle</p>
          <p class="text-sm">Rigorous thermodynamic bookkeeping ensures complete conservation of energy and correct state function manipulation.</p>
        </div>
      </section>

      <section id="interactive" class="mb-8">
        <h2 class="text-xl font-bold mb-3">Educational Interactive Model</h2>
        <p class="text-sm text-foreground/70 mb-4">Use the interactive simulation below to test your understanding live.</p>

        {slug === 'calorimetry' && (
          <CalorimetrySimulator client:load />
        )}

        {slug === 'hess-law' && (
          <HessBuilder client:load />
        )}

        {slug !== 'calorimetry' && slug !== 'hess-law' && (
          <div class="border border-dashed border-primary/50 p-6 rounded-2xl text-center bg-primary/5">
            <p class="text-sm font-semibold mb-2">[ Interactive Model Container for {slug} ]</p>
            <p class="text-xs text-foreground/70">Explore parameters and observe live thermodynamic shifts.</p>
          </div>
        )}
      </section>

      <!-- Navigation -->
      <div class="flex justify-between items-center border-t border-foreground/10 pt-6 mt-8 no-print">
        <a href="/icho-rev/units/thermodynamics" class="text-sm text-foreground/60 hover:underline">← Back to Thermodynamics</a>
        <a href="/icho-rev/units/thermodynamics" class="bg-primary text-white px-4 py-2 rounded-full text-sm font-semibold hover:bg-primary/80">Unit Overview →</a>
      </div>
    </article>
  </main>
</Layout>
