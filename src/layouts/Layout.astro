---
import '../styles/global.css';
import ToggleTheme from '../components/ToggleTheme.astro';
import ToggleCleanMode from '../components/ToggleCleanMode.astro';
import ToggleReduceMotion from '../components/ToggleReduceMotion.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" integrity="sha384-GvrOXuhSPLW+pJ35wQTeBAklWtjpmYB3QH65G8E6uSgLohWICCGcC6u8O77G5qGj" crossorigin="anonymous">
    <title>IChO Rev</title>
  </head>
  <body>
    <nav class="fixed top-0 left-0 w-full p-4 flex gap-4 justify-end no-print z-50">
      <ToggleTheme />
      <ToggleCleanMode />
      <ToggleReduceMotion />
    </nav>
    <slot />
  </body>
</html>
