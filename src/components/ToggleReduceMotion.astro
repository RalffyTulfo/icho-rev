<!-- src/components/ToggleReduceMotion.astro -->
<slot name="toggleReduceMotion" />

<script is:inline>
  import { useState, useEffect } from 'astro:components'

  const ToggleReduceMotion = () => {
    const [reduceMotion, setReduceMotion] = useState(false)
    const toggleReduceMotion = () => {
      setReduceMotion(!reduceMotion)
      document.body.classList.toggle('reduce-motion', !reduceMotion)
      localStorage.setItem('reduceMotion', !reduceMotion)
    }

    useEffect(() => {
      const savedReduceMotion = localStorage.getItem('reduceMotion')
      if (savedReduceMotion !== null) {
        setReduceMotion(savedReduceMotion === 'true')
        document.body.classList.toggle('reduce-motion', savedReduceMotion === 'false')
      }
    }, [])

    return (
      <button
        onClick={toggleReduceMotion}
        class="frosted-glass p-3 rounded-full flex items-center justify-center"
        aria-label="Toggle reduce motion"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2"
          strokeLinecap="round"
          strokeLinejoin="round"
          class="lucide lucide-wave-sine"
        >
          <path d="M12 21v-9l-3 3-3-3v9h6z" />
          <path d="M12 21v-9l3-3 3 3v9h-6z" />
          <path d="M12 21v-9l-3-3 3-3v9h6z" />
          <path d="M12 21v-9l3 3-3 3v9h-6z" />
        </svg>
      </button>
    )
  }
</script>

<style>
  .lucide {
    display: inline-block;
    transition: transform 0.2s ease;
  }
</style>
